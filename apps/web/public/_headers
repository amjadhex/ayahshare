# Response headers for the static files (Workers static assets). Built files under /assets carry a content hash in
# their names, so they never change: browsers keep them a year without asking again. The brand files and icons keep
# their names across releases, so a day, revalidated after.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/brand/*
  Cache-Control: public, max-age=86400, must-revalidate

/icons/*
  Cache-Control: public, max-age=86400, must-revalidate

/landing/*
  Cache-Control: public, max-age=86400, must-revalidate
